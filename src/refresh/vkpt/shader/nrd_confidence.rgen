#version 460
#extension GL_GOOGLE_include_directive : enable

// A separate, deterministic lighting probe. Both evaluations use the same
// proposal distribution (no adaptive shadow statistics) and the same RNG seed.
// Only the scene/lighting can change between a stored probe and its retrace.
#define NRD_CONFIDENCE_TRACE
#include "path_tracer_rgen.h"
#include "projection.glsl"

vec2 confidence_encode_normal(vec3 N)
{
    N /= max(dot(abs(N), vec3(1.0)), 1e-6);
    return N.z >= 0.0 ? N.xy : (1.0 - abs(N.yx)) * mix(vec2(-1.0), vec2(1.0), greaterThanEqual(N.xy, vec2(0.0)));
}

struct ProbeSurface {
    vec3 position;
    vec3 normal;
    vec3 geo_normal;
    vec3 albedo;
    vec3 f0;
    vec3 emissive;
    float roughness;
    float specular_factor;
    float metallic;
    uint material;
    uint cluster;
};

bool probe_surface(Ray ray, out ProbeSurface s)
{
    trace_geometry_ray(ray, true, BOUNCE_RAY_CULL_MASK | AS_FLAG_VIEWER_WEAPON | AS_FLAG_TRANSPARENT);
    if (!found_intersection(ray_payload_geometry)) return false;
    Triangle triangle = get_hit_triangle(ray_payload_geometry);
    if (is_sky(triangle.material_id)) return false;
    vec3 bary = get_hit_barycentric(ray_payload_geometry);
    s.position = triangle.positions * bary;
    s.geo_normal = normalize(triangle.normals * bary);
    if (dot(s.geo_normal, ray.direction) > 0.0) s.geo_normal = -s.geo_normal;
    vec3 base;
    // Probes measure lighting changes, not subpixel texture aliasing. A fixed
    // mip also keeps the previous/current evaluations on the same estimator.
    get_material(triangle, bary, triangle.tex_coords * bary, vec2(0.0), vec2(0.0),
        2.0, s.geo_normal, base, s.normal, s.metallic, s.roughness, s.emissive, s.specular_factor);
    get_reflectivity(base, s.metallic, s.albedo, s.f0);
    s.material = triangle.material_id;
    s.cluster = triangle.cluster;
    return true;
}

vec3 probe_direct(ProbeSurface s, vec3 incoming, int bounce)
{
    vec3 diffuse, specular;
    float unused_distance;
    get_direct_illumination(s.position, s.normal, s.geo_normal, s.cluster, s.material,
        SHADOW_RAY_CULL_MASK, incoming, s.albedo, s.f0, s.specular_factor, s.roughness,
        MEDIUM_NONE, false, 1.0,
        bounce == 0 ? global_ubo.pt_direct_polygon_lights > 0 : global_ubo.pt_indirect_polygon_lights > 0,
        bounce == 0 ? global_ubo.pt_direct_dyn_lights > 0 : global_ubo.pt_indirect_dyn_lights > 0,
        bounce, unused_distance, diffuse, specular);
    vec3 lighting = diffuse * s.albedo + specular;
    if (global_ubo.pt_direct_sun_light != 0) {
        get_sunlight(s.cluster, s.material, s.position, s.normal, s.geo_normal, incoming,
            s.f0, s.specular_factor, s.roughness, MEDIUM_NONE, false, diffuse, specular, SHADOW_RAY_CULL_MASK);
        lighting += diffuse * s.albedo + specular;
    }
    return lighting;
}

vec4 trace_probe(ivec2 pixel, bool previous)
{
    int frame = global_ubo.current_frame_idx - (previous ? 1 : 0);
    uint offset = uint(frame) / NUM_BLUE_NOISE_TEX;
    rng_seed = ((uint(pixel.x * 5) + offset) & (BLUE_NOISE_RES - 1)) << RNG_SEED_SHIFT_X;
    rng_seed |= ((uint(pixel.y * 5) + (offset << 4)) & (BLUE_NOISE_RES - 1)) << RNG_SEED_SHIFT_Y;
    rng_seed |= uint(frame) << RNG_SEED_SHIFT_FRAME;
    ivec2 size = previous ? ivec2(global_ubo.prev_width, global_ubo.prev_height) : ivec2(global_ubo.width, global_ubo.height);
    size = (size + 4) / 5;
    // Both paths invert on the GPU to avoid CPU/GPU inverse rounding differences
    // being interpreted as lighting changes in a stationary camera.
    mat4 view = previous ? global_ubo.V_prev : global_ubo.V;
    mat4 inv_view = inverse(view);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    Ray ray;
    ray.origin = inv_view[3].xyz;
    ray.direction = normalize((inv_view * vec4(projection_screen_to_view(uv, 1.0, previous), 0.0)).xyz);
    ray.t_min = 0.0;
    ray.t_max = PRIMARY_RAY_T_MAX;
    ProbeSurface s;
    if (!probe_surface(ray, s)) return vec4(0.0, 0.0, 0.0, PRIMARY_RAY_T_MAX);
    vec3 lighting = probe_direct(s, ray.direction, 0); // excludes primary emission
    float view_z = (view * vec4(s.position, 1.0)).z;
    vec2 guide_normal = confidence_encode_normal(s.normal);

    if (global_ubo.pt_num_bounce_rays > 0.0) {
        float probability = s.metallic == 1.0 ? 1.0 : 0.5;
        bool specular = get_rng(RNG_BRDF_FRESNEL(1)) < probability;
        vec2 u = vec2(get_rng(RNG_BRDF_X(1)), get_rng(RNG_BRDF_Y(1)));
        mat3 basis = construct_ONB_frisvad(s.normal);
        vec3 direction;
        vec3 weight;
        if (specular) {
            vec3 H = ImportanceSampleGGX_VNDF(u, s.roughness, ray.direction, basis);
            direction = reflect(ray.direction, H);
            float NoL = max(dot(s.normal, direction), 0.0);
            weight = schlick_fresnel(s.f0, max(dot(-ray.direction, H), 0.0), s.specular_factor)
                * G1_Smith(s.roughness, NoL) / probability;
            if (NoL <= 0.0) weight = vec3(0.0);
        } else {
            direction = normalize(basis * sample_cos_hemisphere(u));
            vec3 H = _NRD_SafeNormalize(direction - ray.direction);
            weight = s.albedo * (1.0 - schlick_fresnel(s.f0,
                max(dot(-ray.direction, H), 0.0), s.specular_factor)) / (1.0 - probability);
        }
        ray.origin = s.position - ray.direction * 0.01;
        ray.direction = direction;
        ray.t_max = 10000.0;
        ProbeSurface secondary;
        if (any(greaterThan(weight, vec3(0.0)))) {
            if (probe_surface(ray, secondary))
                lighting += weight * (secondary.emissive + probe_direct(secondary, direction, 1));
            else
                lighting += weight * env_map(direction, true) * global_ubo.pt_env_scale;
        }
    }
    float energy = _NRD_Luminance(max(lighting, vec3(0.0)));
    if (isnan(energy) || isinf(energy)) energy = 0.0;
    // Signed depth marks animated/replaced surfaces for conservative confidence.
    if (is_transparent(s.material) || is_water(s.material) || is_chrome(s.material)) view_z = -abs(view_z);
    return vec4(energy, guide_normal, view_z);
}

void main()
{
    ivec2 pixel = ivec2(rt_LaunchID.xy);
    ivec2 size = (ivec2(global_ubo.width, global_ubo.height) + 4) / 5;
    if (any(greaterThanEqual(pixel, size))) return;
    vec4 current = trace_probe(pixel, false);
    bool even = (global_ubo.current_frame_idx & 1) == 0;
    vec4 stored = vec4(0.0);
    if (global_ubo.nrd_history_valid != 0)
        stored = even ? imageLoad(IMG_NRD_CONFIDENCE_SAMPLE_1, pixel) : imageLoad(IMG_NRD_CONFIDENCE_SAMPLE_0, pixel);
    if (even) imageStore(IMG_NRD_CONFIDENCE_SAMPLE_0, pixel, current);
    else imageStore(IMG_NRD_CONFIDENCE_SAMPLE_1, pixel, current);
    float gradient = 1.0;
    if (global_ubo.nrd_history_valid != 0) {
        vec4 retraced = trace_probe(pixel, true);
        // Normalize in scene-linear space; exposure changes cannot create a
        // gradient. A black, unchanged signal has full confidence.
        gradient = abs(stored.x - retraced.x) / max(max(stored.x, retraced.x), 0.1);
        float depth_delta = abs(abs(stored.w) - abs(retraced.w)) / max(abs(stored.w), 1.0);
        // Primary disocclusions belong to NRD; don't spread their signal across
        // neighboring surfaces. Replaced/animated surfaces remain responsive.
        gradient *= 1.0 - smoothstep(0.05, 0.25, depth_delta);
        if (stored.w < 0.0 || retraced.w < 0.0) gradient = max(gradient, 0.5);
    } else stored = current;
    imageStore(IMG_NRD_CONFIDENCE_GRADIENT_0, pixel, vec4(clamp(gradient, 0.0, 1.0), stored.yzw));
}
