#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"
#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"
#include "utils.glsl"
#include "brdf.glsl"
#include "nrd_common.glsl"

// NRD 4.18 _NRD_YCoCgToLinear.
vec3 nrd_ycocg_to_linear(vec3 color)
{
	float t = color.x - color.z;
	return max(vec3(t + color.y, color.x + color.z, t - color.y), vec3(0.0));
}

// Must match the frame-latched mode used while the NRD instance was created.
int nrd_specular_mode()
{
	return global_ubo.flt_nrd_spec_denoiser >= 0.5 ? 1 : 0;
}

ivec2 checkerboard_source(ivec2 pixel)
{
	int half_width = int(global_ubo.width / 2);
	bool even_field = ((pixel.x & 1) == (pixel.y & 1));
	if (global_ubo.pt_swap_checkerboard != 0)
		even_field = !even_field;
	return ivec2(pixel.x / 2 + (even_field ? 0 : half_width), pixel.y);
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 frame_size = ivec2(global_ubo.width, global_ubo.height);
	if (any(greaterThanEqual(pixel, frame_size)))
		return;

	ivec2 source = checkerboard_source(pixel);
	vec3 direct_diffuse = nrd_ycocg_to_linear(
		texelFetch(TEX_NRD_DIRECT_DIFF_RADIANCE_HITDIST_OUT, pixel, 0).xyz);
	vec3 indirect_diffuse = max(
		texelFetch(TEX_NRD_INDIRECT_DIFF_RADIANCE_HITDIST_OUT, pixel, 0).xyz, vec3(0.0));
	// RELAX_BackEnd_UnpackRadiance is a no-op: RELAX keeps radiance linear,
	// while REBLUR needs the YCoCg conversion undone.  Must match the packing
	// choice made by nrd_prepare.comp for this frame.
	vec3 specular_packed = texelFetch(TEX_NRD_SPEC_RADIANCE_HITDIST_OUT, pixel, 0).xyz;
	const int specular_mode = nrd_specular_mode(); // 0 = REBLUR, 1 = RELAX
	vec3 specular = (specular_mode == 1)
		? max(specular_packed, vec3(0.0))
		: nrd_ycocg_to_linear(specular_packed);
	vec3 base_color = texelFetch(TEX_PT_BASE_COLOR_A, source, 0).rgb;
	vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, source, 0).rg;
    vec3 N = decode_normal(texelFetch(TEX_PT_NORMAL_A, source, 0).x);
    vec3 V = -texelFetch(TEX_PT_VIEW_DIRECTION, source, 0).xyz;
    vec3 unresolved = specular;
    if (global_ubo.flt_nrd_spec_sh >= 0.5) {
        vec4 sh0 = texelFetch(TEX_NRD_SPEC_RADIANCE_HITDIST_OUT, pixel, 0);
        vec3 sh1 = texelFetch(TEX_NRD_SPEC_SH1_OUT, pixel, 0).xyz;
        NRD_SG sg = specular_mode == 1 ? RELAX_BackEnd_UnpackSh(sh0, sh1) : REBLUR_BackEnd_UnpackSh(sh0, sh1);
        unresolved = NRD_SG_ExtractColor(sg);
        specular = NRD_SG_ResolveSpecular(sg, N, V, metal_rough.y);
        const ivec2 offsets[4] = ivec2[4](ivec2(1,0), ivec2(-1,0), ivec2(0,1), ivec2(0,-1));
        vec3 normals[4];
        float depths[4];
        for (int i = 0; i < 4; i++) {
            ivec2 neighbor = clamp(pixel + offsets[i], ivec2(0), frame_size - 1);
            normals[i] = decode_normal(texelFetch(TEX_PT_NORMAL_A, checkerboard_source(neighbor), 0).x);
            depths[i] = texelFetch(TEX_NRD_VIEWZ, neighbor, 0).x;
        }
        float Z = texelFetch(TEX_NRD_VIEWZ, pixel, 0).x;
        // Only the specular component is used; the diffuse SG is a finite dummy.
        vec2 jitter = NRD_SG_ReJitter(sg, sg, V, max(metal_rough.y, 0.05), Z,
            depths[0], depths[1], depths[2], depths[3], N,
            normals[0], normals[1], normals[2], normals[3]);
        specular *= jitter.y;
        if (any(isnan(specular)) || any(isinf(specular))) specular = unresolved;
    }
    vec3 albedo, f0;
    get_reflectivity(base_color, metal_rough.x, albedo, f0);
    vec3 remodulation = nrd_specular_factor(N, V, f0, metal_rough.y) / max(f0, vec3(0.01));
    specular *= remodulation;
    unresolved *= remodulation;
	vec3 throughput = texelFetch(TEX_PT_THROUGHPUT, source, 0).rgb;
	vec4 transparent = texelFetch(TEX_PT_TRANSPARENT, source, 0);
	int flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, source, 0).w);

	vec3 color = composite_color(base_color, metal_rough.r, throughput,
		indirect_diffuse, direct_diffuse, specular, transparent);
    if (global_ubo.flt_nrd_debug >= 0.5 && global_ubo.flt_nrd_debug < 1.5)
        color = vec3(texelFetch(TEX_NRD_SPEC_CONFIDENCE, pixel, 0).x);
    else if (global_ubo.flt_nrd_debug >= 1.5 && global_ubo.flt_nrd_debug < 3.5)
        color = modulate_specular(f0, global_ubo.flt_nrd_debug < 2.5 ? unresolved : specular) * throughput;
    else if (global_ubo.flt_nrd_debug >= 3.5 && global_ubo.flt_nrd_debug < 4.5)
        color = N * 0.5 + 0.5;
    else if (global_ubo.flt_nrd_debug >= 4.5 && global_ubo.flt_nrd_debug < 5.5)
        color = vec3(metal_rough.y);
    else if (global_ubo.flt_nrd_debug >= 5.5 && global_ubo.flt_nrd_debug < 6.5)
        color = modulate_specular(f0,
            unpackRGBE(texelFetch(TEX_PT_COLOR_SPEC, source, 0).x) / STORAGE_SCALE_SPEC) * throughput;
    else if (global_ubo.flt_nrd_debug >= 6.5 && global_ubo.flt_nrd_debug < 7.5)
    {
        // Green means the explicit debug-only marker survived NRD. Ordinary
        // black/unchanged radiance is no longer mistaken for an unwritten pixel.
        vec4 out_d = texelFetch(TEX_NRD_DIRECT_DIFF_RADIANCE_HITDIST_OUT, pixel, 0);
        color = out_d.w == -1.0 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    }
    else if (global_ubo.flt_nrd_debug >= 7.5)
        color = vec3(texelFetch(TEX_NRD_VIEWZ, pixel, 0).x / 4096.0);
	// Store in the checkerboard layout the interleave pass expects: pixel ->
	// source is a bijection, so nothing is lost, and the regular interleave
	// pass then produces FLAT_COLOR/FLAT_MOTION and the FSR3 masks as usual.
	imageStore(IMG_ASVGF_COLOR, source, vec4(color * STORAGE_SCALE_HDR, flags));
}
